{
  "extends": "$app/tsconfig",
  // Kit 3's base config lists no files, so without these TypeScript and
  // svelte-check would also read `build/` after a build. The lists are the ones
  // SvelteKit's own `tsconfig_extends_missing` message recommends.
  "include": ["src", "test", "*"],
  "exclude": ["src/service-worker"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "bundler",
    // `#lib` is a package.json subpath import (SvelteKit 3 removed `$lib`). Vite
    // resolves it from package.json; TypeScript does not add file extensions
    // to a subpath-import target, so it reads the same mapping from here.
    "paths": {
      "#lib/*": ["./src/lib/*"]
    }
  }
  // Path aliases are handled by https://svelte.dev/docs/kit/configuration#alias
  // except #lib, which is the paths entry above and package.json's `imports`
  //
  // If you want to overwrite includes/excludes, make sure to copy over the relevant includes/excludes
  // from the referenced tsconfig.json - TypeScript does not merge them in
}
